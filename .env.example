# Supabase > Project Settings > API. Server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# T2. Same values locally and in Vercel: they share one database.
EVENT_CODE=            # goes in the group-chat link: /?c=<EVENT_CODE>
SESSION_SECRET=        # 32 random bytes, base64
PIN_ENCRYPTION_KEY=    # 32 random bytes, base64. Changing it makes every guest PIN unreadable.
